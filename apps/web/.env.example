# VDM Nexus marketing site env vars
# Copy to .env.local and fill in your values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — used by waitlist/roadmap/buildlog/receipts API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin gate ---
# Protects /admin/* and admin write endpoints. Also accepted via X-Admin-Secret
# header for tooling.
ADMIN_PASSWORD=

# --- Waitlist + abuse signals ---
# Salt for hashing client IP before storing on waitlist rows. Must match the
# nexus app's IP_HASH_SALT if you want grant + waitlist abuse signals to
# correlate.
IP_HASH_SALT=

# --- Notifications (all optional) ---
# Resend transactional email — fired fire-and-forget on waitlist signup.
RESEND_API_KEY=
RESEND_FROM=                          # e.g. hello@vdmnexus.com
# Slack incoming webhook — internal notification on waitlist signup.
SLACK_WEBHOOK_URL=

# --- Token launch gate ---
# Defaults to false (fail-closed) — /token and /whitepaper return 404 and are
# absent from nav/footer/robots until this is "true". Flip on Vercel only when
# the token is live and legal sign-off is in.
NEXT_PUBLIC_LAUNCH_LIVE=false

# --- Nexus API endpoints (consumed by /playground and /api/playground/*) ---
# Public Nexus base URL surfaced to client code. Defaults to production.
NEXT_PUBLIC_NEXUS_URL=
# Server-side URL the playground API routes call. Defaults to
# https://nexus.vdmnexus.com/api/v1.
NEXUS_INFERENCE_URL=

# --- Playground sponsored grant ---
# Base58 64-byte secret of the agent that signs the sponsored credit on
# behalf of fresh /playground visitors. Must have a funded balance on the
# nexus rail.
PLAYGROUND_AGENT_SECRET_KEY=

# --- Wallet connect (consumed by /app and the nav connect button) ---
# Reown/WalletConnect Cloud project id. Without it the site is
# injected-wallet-only and says so in the UI.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Rienda contracts (consumed by /live and /api/rienda/live) ---
# All optional. With NEXT_PUBLIC_RIENDA_FACTORY_ADDRESS unset, /live renders
# its "nothing deployed yet" state and makes no RPC calls at all. Set the
# factory address after the Robinhood Chain testnet deploy, then redeploy the
# site to turn the live view on.
#
# VaultFactory. The only address that gates the live view.
NEXT_PUBLIC_RIENDA_FACTORY_ADDRESS=
# Mock price oracle used on testnet. Display-only.
NEXT_PUBLIC_RIENDA_MOCK_ORACLE=
# ERC-20 the vaults denominate in. Used to label NAV with a symbol and to
# scale raw uint256 balances by the token's decimals.
NEXT_PUBLIC_RIENDA_SETTLEMENT_TOKEN=
# Chain the addresses live on. Defaults to 46630 (Robinhood Chain testnet).
# Only 46630 and 4663 are accepted; anything else falls back to testnet.
NEXT_PUBLIC_RIENDA_CHAIN_ID=
# Block the factory was deployed at. Optional but recommended — without it
# the vault-list query scans the last 100k blocks instead of full history.
NEXT_PUBLIC_RIENDA_DEPLOY_BLOCK=
# Comma-separated vault addresses. Escape hatch for the window between the
# deploy and the ABI reconciliation: if the deployed VaultCreated event does
# not match the provisional fragments in lib/rienda-abi.ts, the log-derived
# list comes back empty, and pinning addresses here still gets real vault
# state onto the page. Merged with, not replacing, the log-derived list.
NEXT_PUBLIC_RIENDA_VAULT_ADDRESSES=
# Server-side RPC override for the live reader. Falls back to the public
# endpoint in lib/chains.ts. Set this if the public RPC rate-limits the poll.
RIENDA_RPC_URL=

# --- Base/EVM agent registration ---
# Optional deposit address advertised in /.well-known/agent-registration.json
# for the Base (EVM) network. Leave blank to omit Base from the agent card.
BASE_DEPOSIT_ADDRESS=

# Required Supabase schema:
#
# create table waitlist (
#   id uuid primary key default gen_random_uuid(),
#   email text not null unique,
#   building text,
#   created_at timestamptz default now()
# );
#
# alter table waitlist enable row level security;
# create policy "anon can insert waitlist"
#   on waitlist for insert to anon with check (true);

# Rienda live view — Robinhood Chain testnet deployment (2026-08-04)
NEXT_PUBLIC_RIENDA_CHAIN_ID=46630
NEXT_PUBLIC_RIENDA_FACTORY_ADDRESS=0xa8551b0e275c5ffA018188BA0B39129e1a52e057
NEXT_PUBLIC_RIENDA_SETTLEMENT_TOKEN=0x8072ebeaa838B31C6Ea86cc000bf0fd3751a61E1
NEXT_PUBLIC_RIENDA_MOCK_ORACLE=0xe88Cbc9843E0DF2507F38A5f4971dbbb6C8665f3
NEXT_PUBLIC_RIENDA_VAULT_ADDRESSES=0x7d8886c1C83E5a3f07993077c8Dd7783aFE81A3f
NEXT_PUBLIC_RIENDA_DEPLOY_BLOCK=96985517
